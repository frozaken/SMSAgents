{
  "description": "Deliver SMSAgents messages at agent lifecycle boundaries.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/hook.js",
            "statusMessage": "Checking SMSAgents inbox",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/hook.js",
            "statusMessage": "Registering with SMSAgents",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/hook.js",
            "statusMessage": "Checking for new agent messages",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
